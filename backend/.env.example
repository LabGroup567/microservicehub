# Copy to .env and fill in. Never commit the real .env file.
PORT=5000

# Database (XAMPP defaults)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=micro_service_hub

# Google sign-in (optional)
GOOGLE_CLIENT_ID=

# Generated automatically on first start if missing
JWT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Extra frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=

# Only verified (KYC) providers may apply to work
REQUIRE_KYC=false

# Set to 1 when running behind a reverse proxy (so rate limits see the real IP)
TRUST_PROXY=

# ---------- Deployment (hosted backend) ----------
# Public address of THIS backend, used for payment callbacks (no trailing slash)
API_PUBLIC_URL=https://your-backend.onrender.com
# Public address of the website, used in emails and redirects (the same address when one service hosts both)
APP_URL=https://your-backend.onrender.com
# Only needed when the website is hosted at a different address than this backend
CORS_ORIGINS=

# Hosted MySQL usually needs an encrypted connection
DB_SSL=false
DB_SSL_CA=

# First admin on a fresh server (no shell needed). Used only when no admin exists. Remove afterwards.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Main Admin

# Email (SMTP). Gmail example: smtp.gmail.com, 587, your address and an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MicroServiceHub <your-address@gmail.com>

# Text messages (optional): twilio or bulksmsbd
SMS_PROVIDER=

# Set to 1 behind a reverse proxy such as Render so rate limits see real visitor addresses
TRUST_PROXY=1
